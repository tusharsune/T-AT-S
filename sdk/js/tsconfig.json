{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "moduleResolution": "node",
    "baseUrl": ".",
    "paths": {
      "react": ["../../frontend/node_modules/@types/react"],
      "react/*": ["../../frontend/node_modules/@types/react/*"],
      "react/jsx-runtime": ["../../frontend/node_modules/@types/react/jsx-runtime"]
    },
    "jsx": "react-jsx",
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true

  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "test"]
}

